        {
            "id": "RMB-001",
            "name": "Wavelength Calculation (Dispersion Relation)",
            "category": "Wave Properties",
            "latex": "L = \\frac{gT^2}{2\\pi} \\tanh\\left(\\frac{2\\pi h}{L}\\right)",
            "description": "Iterative calculation of wavelength at a given water depth",
            "variables": {
                "L": {
                    "description": "Wavelength at depth h",
                    "unit": "m",
                    "type": "output"
                },
                "Lo": {
                    "description": "Deep water wavelength",
                    "unit": "m",
                    "type": "input"
                },
                "g": {
                    "description": "Gravitational acceleration",
                    "unit": "m/s²",
                    "type": "constant",
                    "value": 9.81
                },
                "T": {
                    "description": "Wave period",
                    "unit": "s",
                    "type": "input"
                },
                "h": {
                    "description": "Water depth",
                    "unit": "m",
                    "type": "input"
                }
            },
            "sourceReference": {
                "page": 2,
                "equationNumber": "implicit"
            },
            "verification": {
                "status": "verified",
                "example": {
                    "given": {
                        "T": 8,
                        "h": 7.2,
                        "Lo": 100
                    },
                    "expected": {
                        "Lm": 62
                    },
                    "calculated": 62,
                    "errorPercent": 0
                }
            }
        },
        {
